---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import EventCard from '../components/EventCard.astro';

// Enhanced Concert Lineup
const featuredEvents = [
  {
    id: 1,
    title: "ECHOES OF TOMORROW 2026",
    artist: "KSHMR & ANYMA",
    venue: "GBK Stadium, Jakarta",
    date: "SAT, 15 AUG 2026",
    price: "Rp 450.000",
    category: "Electronic",
    image: "/poster_1.jpg",
    quotaLeft: 24,
  },
  {
    id: 2,
    title: "MIDNIGHT RESONANCE LIVE",
    artist: "The Underground Orchestra",
    venue: "JIExpo Hall C1, Jakarta",
    date: "FRI, 28 AUG 2026",
    price: "Rp 350.000",
    category: "Indie Rock",
    image: "/poster_2.jpg",
    quotaLeft: 120,
  },
  {
    id: 3,
    title: "SUB-ZERO WAREHOUSE RAVE",
    artist: "Charlotte de Witte & Amelie Lens",
    venue: "Bengkel Space, Bali",
    date: "SAT, 12 SEP 2026",
    price: "Rp 600.000",
    category: "Techno",
    image: "/poster_3.jpg",
    quotaLeft: 12,
  },
  {
    id: 4,
    title: "ACOUSTIC REVERIE UNPLUGGED",
    artist: "Tulus & Isyana Sarasvati",
    venue: "Taman Ismail Marzuki, Jakarta",
    date: "SUN, 04 OCT 2026",
    price: "Rp 275.000",
    category: "Acoustic",
    image: "/hero_banner.jpg",
    quotaLeft: 45,
  }
];

const partners = ["BOILER ROOM", "RESIDENT ADVISOR", "SPOTIFY", "PIONEER DJ", "NATIVE INSTRUMENTS", "SPLICE", "ABLETON"];
const genres = ["All Shows", "Electronic", "Indie Rock", "Techno", "Acoustic", "Hip Hop"];
---

<Layout title="SymphoniaTic — Get Tickets to the Best Live Shows & Concerts">
  <Navbar />

  <main class="overflow-x-hidden w-full max-w-full">
    <!-- HERO SECTION (DICE.fm Aesthetic) -->
    <section class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-20 overflow-hidden">
      <!-- Ambient Concert Background -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/hero_banner.jpg" 
          alt="Live concert crowd atmosphere" 
          class="w-full h-full object-cover object-center opacity-30 scale-105 filter brightness-90 animate-pulse-slow"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0d0d0f] via-[#0d0d0f]/60 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#0d0d0f] via-transparent to-[#0d0d0f]"></div>
      </div>

      <!-- Glowing Neon Background Orbs -->
      <div class="absolute top-1/4 left-1/3 w-[500px] h-[500px] bg-[#e5fe40]/10 rounded-full blur-[160px] pointer-events-none"></div>
      <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-purple-600/10 rounded-full blur-[180px] pointer-events-none"></div>

      <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Top Pill Tag -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full badge-tag mb-8 text-xs font-black uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-[#e5fe40] animate-ping"></span>
          NO RESELLERS • LOCKED PRICES • VERIFIED QR PASSES
        </div>

        <!-- Headline -->
        <h1 class="hero-text font-display font-black text-5xl sm:text-7xl lg:text-8xl tracking-tight leading-[0.95] text-white max-w-5xl mx-auto mb-6">
          NEVER MISS A <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#e5fe40] via-yellow-200 to-white">
            LIVE SHOW AGAIN.
          </span>
        </h1>

        <p class="hero-sub text-zinc-400 text-base sm:text-xl max-w-2xl mx-auto font-normal mb-10 leading-relaxed">
          SymphoniaTic connects fans with unforgettable live music experiences. Direct artist access, zero scalper markups, and instant QR entry.
        </p>

        <!-- CTA Buttons -->
        <div class="hero-btns flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
          <a 
            href="#events" 
            class="w-full sm:w-auto px-9 py-4 bg-[#e5fe40] hover:bg-[#d2ec2f] text-black font-extrabold text-xs uppercase tracking-wider rounded-full transition-all duration-300 transform hover:scale-105 active:scale-95 shadow-xl shadow-[#e5fe40]/15 flex items-center justify-center gap-3"
          >
            <span>Explore Shows</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </a>

          <a 
            href="/register" 
            class="w-full sm:w-auto px-9 py-4 bg-zinc-900/90 hover:bg-zinc-800 text-white border border-zinc-700 font-extrabold text-xs uppercase tracking-wider rounded-full transition-all duration-300 flex items-center justify-center gap-2"
          >
            Create Account
          </a>
        </div>

        <!-- Key Feature Highlights -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto mt-16 pt-12 border-t border-zinc-800/60 text-left">
          <div>
            <div class="font-display font-black text-3xl text-[#e5fe40]">100%</div>
            <div class="text-zinc-400 text-xs font-bold uppercase tracking-wider mt-1">Verified Tickets</div>
          </div>
          <div>
            <div class="font-display font-black text-3xl text-white">MAX 4</div>
            <div class="text-zinc-400 text-xs font-bold uppercase tracking-wider mt-1">Per Transaction</div>
          </div>
          <div>
            <div class="font-display font-black text-3xl text-white">QR-SYM</div>
            <div class="text-zinc-400 text-xs font-bold uppercase tracking-wider mt-1">Instant Entry Pass</div>
          </div>
          <div>
            <div class="font-display font-black text-3xl text-[#e5fe40]">0%</div>
            <div class="text-zinc-400 text-xs font-bold uppercase tracking-wider mt-1">Hidden Scalper Fees</div>
          </div>
        </div>
      </div>
    </section>

    <!-- CONTINUOUS MARQUEE -->
    <div class="py-6 bg-black/60 border-y border-zinc-800/80 overflow-hidden whitespace-nowrap">
      <div class="inline-flex gap-12 animate-marquee-slow">
        {partners.concat(partners).map((partner) => (
          <span class="font-display font-extrabold text-lg text-zinc-600 hover:text-white transition-colors uppercase tracking-widest cursor-default">
            ★ {partner}
          </span>
        ))}
      </div>
    </div>

    <!-- SHOW LISTINGS SECTION -->
    <section id="events" class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <span class="text-[#e5fe40] font-black text-xs uppercase tracking-widest block mb-2">Live Music & Concerts</span>
          <h2 class="font-display font-black text-4xl sm:text-6xl text-white tracking-tight">
            UPCOMING CONCERTS
          </h2>
        </div>

        <!-- Genre Pill Filter -->
        <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
          {genres.map((genre, idx) => (
            <button class={`px-4 py-2 rounded-full text-xs font-extrabold whitespace-nowrap transition-all ${
              idx === 0 
                ? 'bg-[#e5fe40] text-black shadow-md' 
                : 'bg-zinc-900/90 text-zinc-400 hover:text-white border border-zinc-800 hover:border-zinc-700'
            }`}>
              {genre}
            </button>
          ))}
        </div>
      </div>

      <!-- Event Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredEvents.map((evt) => (
          <EventCard 
            title={evt.title}
            artist={evt.artist}
            venue={evt.venue}
            date={evt.date}
            price={evt.price}
            category={evt.category}
            image={evt.image}
            quotaLeft={evt.quotaLeft}
          />
        ))}
      </div>
    </section>

    <!-- ANTI-SCALPER SYSTEM ARCHITECTURE -->
    <section id="system" class="py-24 bg-[#141418] border-y border-zinc-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="font-display font-black text-4xl sm:text-5xl text-white tracking-tight mb-4">
            ENGINEERED FOR TRUE FANS
          </h2>
          <p class="text-zinc-400 text-base sm:text-lg">
            SymphoniaTic eliminates ticket bots and unfair pricing through database-isolated transaction processing.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-8 rounded-3xl bg-[#0d0d0f] border border-zinc-800 hover:border-[#e5fe40]/40 transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-[#e5fe40]/10 text-[#e5fe40] flex items-center justify-center mb-6 font-display font-black text-xl">
              01
            </div>
            <h3 class="font-display font-bold text-2xl text-white mb-3">Atomic Quota Engine</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">
              Database row locking (`SELECT FOR UPDATE`) within `db.Begin()` transactions prevents ticket overbooking even during high-traffic drops.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-[#0d0d0f] border border-zinc-800 hover:border-[#e5fe40]/40 transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-[#e5fe40]/10 text-[#e5fe40] flex items-center justify-center mb-6 font-display font-black text-xl">
              02
            </div>
            <h3 class="font-display font-bold text-2xl text-white mb-3">Dynamic QR-SYM Pass</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">
              Digital passes are encrypted and generated upon admin payment clearance, preventing unauthorized screenshot resale.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-[#0d0d0f] border border-zinc-800 hover:border-[#e5fe40]/40 transition-all group">
            <div class="w-12 h-12 rounded-2xl bg-[#e5fe40]/10 text-[#e5fe40] flex items-center justify-center mb-6 font-display font-black text-xl">
              03
            </div>
            <h3 class="font-display font-bold text-2xl text-white mb-3">Strict 4 Ticket Limit</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">
              Single user accounts are restricted to 4 tickets per transaction, ensuring equal access for real music lovers.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ACTION CTA BANNER -->
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="relative rounded-3xl bg-gradient-to-r from-[#e5fe40] to-yellow-300 p-10 sm:p-16 text-black overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl">
          <div class="max-w-2xl z-10">
            <h2 class="font-display font-black text-4xl sm:text-6xl tracking-tight leading-tight mb-4">
              READY FOR YOUR NEXT SHOW?
            </h2>
            <p class="font-semibold text-black/80 text-lg">
              Create your account today and get early access to upcoming concert ticket drops.
            </p>
          </div>
          <div class="shrink-0 z-10">
            <a href="/register" class="px-8 py-4 bg-black text-white hover:bg-zinc-900 font-extrabold text-xs uppercase tracking-wider rounded-full transition-transform hover:scale-105 active:scale-95 inline-block shadow-2xl">
              Get Started Now
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-[#0d0d0f] border-t border-zinc-800/80 pt-16 pb-12 text-zinc-400 text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          <div class="md:col-span-2">
            <a href="/" class="flex items-center gap-2.5 mb-4">
              <div class="w-8 h-8 rounded-lg bg-[#e5fe40] flex items-center justify-center text-black font-black text-lg font-display">
                S
              </div>
              <span class="font-display font-black text-xl tracking-wider text-white">
                SYMPHONIA<span class="text-[#e5fe40]">TIC</span>
              </span>
            </a>
            <p class="text-zinc-500 max-w-sm text-xs leading-relaxed mb-6">
              SymphoniaTic is the premier ticket booking platform built for live music lovers, artists, and event organizers.
            </p>
            <div class="flex items-center gap-4 text-xs">
              <a href="https://github.com/Zyrexnn/SymphoniaTic" target="_blank" class="hover:text-white transition-colors">GitHub Repository</a>
              <span>•</span>
              <a href="/PRD.md" target="_blank" class="hover:text-white transition-colors">PRD Spec</a>
            </div>
          </div>

          <div>
            <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-4 font-display">Explore</h4>
            <ul class="space-y-2.5 text-xs">
              <li><a href="#events" class="hover:text-[#e5fe40] transition-colors">Upcoming Concerts</a></li>
              <li><a href="#system" class="hover:text-[#e5fe40] transition-colors">Anti-Scalper System</a></li>
              <li><a href="/login" class="hover:text-[#e5fe40] transition-colors">Admin Dashboard</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-4 font-display">Legal & Trust</h4>
            <ul class="space-y-2.5 text-xs">
              <li><a href="#" class="hover:text-white transition-colors">Privacy Policy</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Terms of Service</a></li>
              <li><a href="#" class="hover:text-white transition-colors">Fair Ticketing Guarantee</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-8 border-t border-zinc-900 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-600 gap-4">
          <div>© 2026 SymphoniaTic Inc. All rights reserved.</div>
          <div>Inspired by DICE.fm aesthetics & built with Astro SSR + Go Fiber.</div>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  @keyframes marquee-slow {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee-slow {
    animation: marquee-slow 28s linear infinite;
  }
</style>
