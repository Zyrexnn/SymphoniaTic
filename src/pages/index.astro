---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import EventCard from '../components/EventCard.astro';

const events = [
  {
    index: "01",
    title: "ECHOES OF TOMORROW",
    artist: "KSHMR & ANYMA",
    date: "15.08.2026",
    venue: "GBK STADIUM, JAKARTA",
    price: "IDR 450.000",
    image: "/poster_1.jpg"
  },
  {
    index: "02",
    title: "MIDNIGHT RESONANCE",
    artist: "UNDERGROUND ORCHESTRA",
    date: "28.08.2026",
    venue: "JIEXPO HALL C1, JAKARTA",
    price: "IDR 350.000",
    image: "/poster_2.jpg"
  },
  {
    index: "03",
    title: "SUB-ZERO WAREHOUSE",
    artist: "CHARLOTTE DE WITTE",
    date: "12.09.2026",
    venue: "BENGKEL SPACE, BALI",
    price: "IDR 600.000",
    image: "/poster_3.jpg"
  }
];

const marqueeWords = ["RAW SOUND", "NO RESELLERS", "ATOMIC QUOTA", "LOCKED PRICES", "QR-SYM PASS", "UNDERGROUND ACCESS"];
---

<Layout>
  <Navbar />

  <main class="w-full max-w-full pt-20 grain-overlay">
    <!-- ========================================== -->
    <!-- HERO SECTION: EDITORIAL BRUTALISM WIDE     -->
    <!-- ========================================== -->
    <section class="relative min-h-[90vh] flex flex-col justify-between p-6 sm:p-12 lg:p-16 border-b border-[#ff1e42]/20 overflow-hidden">
      <!-- Background Graphic & Grid -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/hero_bg_mono.jpg" 
          alt="Concert stage" 
          class="w-full h-full object-cover opacity-15 filter grayscale contrast-200"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#070709] via-transparent to-[#070709]"></div>
      </div>

      <!-- Top Meta Pill -->
      <div class="relative z-10 font-mono text-xs text-[#ff1e42] tracking-widest uppercase mb-8">
        [ SYSTEM VERIFIED // MAX 4 TICKETS PER USER ]
      </div>

      <!-- Main Headline: Huge Editorial Layout -->
      <div class="relative z-10 max-w-6xl">
        <h1 class="font-display font-black text-5xl sm:text-7xl lg:text-9xl text-white uppercase tracking-tighter leading-[0.9] mb-8">
          LIVE SOUND <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#ff1e42] via-rose-300 to-white">WITHOUT MIDDLEMEN.</span>
        </h1>

        <p class="font-mono text-base sm:text-lg text-zinc-400 max-w-2xl leading-relaxed mb-10">
          SymphoniaTic is an uncompromised live music ticket system. Powered by Go Fiber atomic concurrency, locked face-value prices, and dynamic QR passes.
        </p>

        <div class="flex flex-wrap items-center gap-6">
          <a href="#lineup" class="btn-raw-crimson">
            EXPLORE SHOWS NOW
          </a>
          <a href="/register" class="btn-raw-outline">
            CREATE ACCOUNT
          </a>
        </div>
      </div>

      <!-- Hero Footer Bar -->
      <div class="relative z-10 mt-16 pt-8 border-t border-zinc-800 flex flex-wrap items-center justify-between font-mono text-xs text-zinc-500 gap-4">
        <div>LOCATION // INDONESIA (JKT / BALI / SBY)</div>
        <div class="text-[#ff1e42]">STATUS // ATOMIC ENGINE ACTIVE</div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- INFINITE BRUTALIST MARQUEE                 -->
    <!-- ========================================== -->
    <div class="bg-[#ff1e42] text-black py-4 font-display font-black text-2xl uppercase tracking-wider overflow-hidden whitespace-nowrap">
      <div class="inline-flex gap-12 animate-marquee-fast">
        {marqueeWords.concat(marqueeWords).map((word) => (
          <span>★ {word}</span>
        ))}
      </div>
    </div>

    <!-- ========================================== -->
    <!-- LINEUP SECTION (ASYMMETRICAL LAYOUT)      -->
    <!-- ========================================== -->
    <section id="lineup" class="py-24 px-6 sm:px-12 lg:px-16 max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 pb-6 border-b border-[#ff1e42]/20">
        <div>
          <span class="font-mono text-xs text-[#ff1e42] tracking-widest uppercase block mb-2">// CURATED CONCERTS</span>
          <h2 class="font-display font-black text-4xl sm:text-6xl text-white uppercase tracking-tight">
            UPCOMING LINEUP
          </h2>
        </div>
        <div class="font-mono text-xs text-zinc-400">
          SHOWING 3 OF 12 VERIFIED EVENTS
        </div>
      </div>

      <!-- Event Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {events.map((evt) => (
          <EventCard 
            index={evt.index}
            title={evt.title}
            artist={evt.artist}
            date={evt.date}
            venue={evt.venue}
            price={evt.price}
            image={evt.image}
          />
        ))}
      </div>
    </section>

    <!-- ========================================== -->
    <!-- MANIFESTO SECTION (EDITORIAL SPLIT)        -->
    <!-- ========================================== -->
    <section id="manifesto" class="py-24 px-6 sm:px-12 lg:px-16 bg-[#101014] border-y border-[#ff1e42]/20">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5">
          <span class="font-mono text-xs text-[#ff1e42] tracking-widest uppercase block mb-2">// THE MANIFESTO</span>
          <h2 class="font-display font-black text-4xl sm:text-6xl text-white uppercase tracking-tight leading-none mb-6">
            ANTI-SCALPER <br />
            <span class="text-[#ff1e42]">BY DESIGN.</span>
          </h2>
          <p class="font-mono text-sm text-zinc-400 leading-relaxed mb-6">
            Commercial ticket scalping ruins live culture. SymphoniaTic locks ticket limits directly into the database transaction layer.
          </p>
        </div>

        <div class="lg:col-span-7 space-y-6 font-mono text-xs">
          <div class="p-6 bg-[#070709] border border-[#ff1e42]/30">
            <div class="text-[#ff1e42] font-bold text-sm mb-2">01 // ATOMIC QUOTA TRANSACTION</div>
            <p class="text-zinc-400 leading-relaxed">
              When an order is approved, a Go Fiber `db.Begin()` transaction locks the row (`FOR UPDATE`) to prevent overbooking during high-concurrency ticket drops.
            </p>
          </div>

          <div class="p-6 bg-[#070709] border border-zinc-800">
            <div class="text-white font-bold text-sm mb-2">02 // MAXIMUM 4 TICKETS POLICY</div>
            <p class="text-zinc-400 leading-relaxed">
              Every customer is limited to a maximum of 4 tickets per transaction, ensuring fair distribution among real fans.
            </p>
          </div>

          <div class="p-6 bg-[#070709] border border-zinc-800">
            <div class="text-white font-bold text-sm mb-2">03 // DYNAMIC QR-SYM ENTRY CODE</div>
            <p class="text-zinc-400 leading-relaxed">
              Dynamic encrypted verification codes are generated upon admin verification, preventing screenshot sharing and unauthorized resale.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- ACTION: MASSIVE BRUTALIST CTA              -->
    <!-- ========================================== -->
    <section class="py-24 px-6 sm:px-12 text-center bg-[#ff1e42] text-black">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display font-black text-5xl sm:text-7xl lg:text-8xl uppercase tracking-tighter leading-none mb-6">
          GET YOUR PASS NOW.
        </h2>
        <p class="font-mono font-bold text-sm sm:text-base max-w-xl mx-auto mb-8 uppercase">
          Create an account to access verified live show tickets instantly.
        </p>
        <a href="/register" class="inline-block px-10 py-5 bg-black text-white font-display font-black text-sm uppercase tracking-widest hover:bg-white hover:text-black transition-colors shadow-2xl">
          REGISTER ACCOUNT
        </a>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-[#070709] py-12 px-6 sm:px-12 font-mono text-xs text-zinc-500 border-t border-[#ff1e42]/20">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>© 2026 SYMPHONIATIC // UNDERGROUND LIVE ACCESS</div>
        <div class="flex items-center gap-6">
          <a href="https://github.com/Zyrexnn/SymphoniaTic" target="_blank" class="hover:text-white transition-colors">GITHUB</a>
          <a href="/PRD.md" target="_blank" class="hover:text-white transition-colors">PRD SPEC</a>
          <a href="/DESIGN.md" target="_blank" class="hover:text-white transition-colors">DESIGN MD</a>
        </div>
      </div>
    </footer>
  </main>
</Layout>
