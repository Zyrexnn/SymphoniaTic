---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import EventCard from '../components/EventCard.astro';

// Structured Concert Inventory
const featuredConcerts = [
  {
    title: "SymphoniaTic iX3 — Echoes of Tomorrow",
    tagline: "High-voltage electronic stadium performance",
    date: "15 AUG 2026",
    venue: "GBK Stadium, Jakarta",
    price: "IDR 450.000",
    image: "/poster_1.jpg",
  },
  {
    title: "SymphoniaTic M5 — Midnight Resonance",
    tagline: "Symphonic indie rock orchestrations",
    date: "28 AUG 2026",
    venue: "JIExpo Hall C1, Jakarta",
    price: "IDR 350.000",
    image: "/poster_2.jpg",
  },
  {
    title: "SymphoniaTic i7 — Sub-Zero Warehouse",
    tagline: "Underground dark techno industrial series",
    date: "12 SEP 2026",
    venue: "Bengkel Space, Bali",
    price: "IDR 600.000",
    image: "/poster_3.jpg",
  },
  {
    title: "SymphoniaTic X7 — Acoustic Reverie",
    tagline: "Intimate vocal acoustic unplugged tour",
    date: "04 OCT 2026",
    venue: "Taman Ismail Marzuki, Jakarta",
    price: "IDR 275.000",
    image: "/bmw_hero.jpg",
  }
];

const categoryTabs = ["ALL MODELS", "ELECTRONIC", "INDIE ROCK", "TECHNO", "ACOUSTIC", "VIP EXPERIENCE"];
---

<Layout title="SymphoniaTic — Official Live Concerts & Verified Tickets">
  <Navbar />

  <main class="w-full max-w-full pt-[64px]">
    <!-- ========================================== -->
    <!-- HERO BAND: DARK NAVY HERO (80px Section)   -->
    <!-- ========================================== -->
    <section class="bg-[#1a2129] text-white py-[80px] px-6 sm:px-12 relative overflow-hidden">
      <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Text Column -->
        <div class="lg:col-span-6 z-10">
          <div class="text-[13px] font-bold tracking-[1.5px] uppercase text-[#1c69d4] mb-4">
            SYMPHONIATIC LIVE PERFORMANCE
          </div>
          <!-- Hero H1: 64px / 700 Weight / 1.05 Line Height -->
          <h1 class="font-bold text-[40px] sm:text-[56px] lg:text-[64px] leading-[1.05] tracking-tight mb-6 text-white">
            THE NEW ERA OF LIVE MUSIC TICKETING.
          </h1>
          <!-- Body 300 Light Weight -->
          <p class="font-light text-[18px] text-[#bbbbbb] leading-[1.55] mb-8 max-w-xl">
            Engineered for fair access. Experience verified face-value tickets, zero reseller markups, and instant QR-SYM digital passes.
          </p>

          <!-- Buttons: Rectangular (0px radius) -->
          <div class="flex flex-wrap items-center gap-4">
            <a href="#featured" class="btn-bmw-primary">
              EXPLORE MODELS
            </a>
            <a href="/register" class="btn-bmw-secondary">
              BUILD RESERVATION
            </a>
          </div>
        </div>

        <!-- Vehicle / Stage Hero Render Column -->
        <div class="lg:col-span-6 z-10">
          <div class="aspect-[16/9] overflow-hidden border border-white/10 bg-[#262e38]">
            <img 
              src="/bmw_hero.jpg" 
              alt="SymphoniaTic Stage Performance" 
              class="w-full h-full object-cover filter contrast-110"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- CATEGORY TABS SUB-NAVIGATION              -->
    <!-- ========================================== -->
    <section class="bg-white hairline-bottom px-6 sm:px-12">
      <div class="max-w-[1440px] mx-auto flex items-center gap-8 overflow-x-auto py-4">
        {categoryTabs.map((tab, idx) => (
          <button class={`text-[13px] font-bold tracking-[1.5px] uppercase whitespace-nowrap pb-1 border-b-2 transition-colors ${
            idx === 0 
              ? 'border-[#1c69d4] text-[#1c69d4]' 
              : 'border-transparent text-[#6b6b6b] hover:text-[#262626]'
          }`}>
            {tab}
          </button>
        ))}
      </div>
    </section>

    <!-- ========================================== -->
    <!-- MODEL CARDS GRID SECTION (80px Section)   -->
    <!-- ========================================== -->
    <section id="featured" class="py-[80px] px-6 sm:px-12 bg-white">
      <div class="max-w-[1440px] mx-auto">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 hairline-bottom">
          <div>
            <h2 class="font-bold text-[32px] md:text-[48px] text-[#262626] leading-[1.1]">
              FEATURED CONCERT MODELS.
            </h2>
            <p class="font-light text-[16px] text-[#3c3c3c] mt-2">
              Select an upcoming event model to configure your ticket tier and reserve seats.
            </p>
          </div>
          <div class="mt-4 md:mt-0">
            <a href="#" class="uppercase-link">
              VIEW ALL SHOWS <span class="font-bold">›</span>
            </a>
          </div>
        </div>

        <!-- 4-Up Grid Layout -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {featuredConcerts.map((concert) => (
            <EventCard 
              title={concert.title}
              tagline={concert.tagline}
              date={concert.date}
              venue={concert.venue}
              price={concert.price}
              image={concert.image}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- TECHNICAL SPECIFICATIONS & SYSTEM BAND    -->
    <!-- ========================================== -->
    <section id="system" class="py-[80px] px-6 sm:px-12 bg-[#fafafa] hairline-bottom">
      <div class="max-w-[1440px] mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="text-[13px] font-bold tracking-[1.5px] uppercase text-[#1c69d4] mb-3">
            SYSTEM ARCHITECTURE
          </div>
          <h2 class="font-bold text-[32px] md:text-[48px] text-[#262626] leading-[1.1] mb-4">
            ENGINEERED PRECISION TICKETING.
          </h2>
          <p class="font-light text-[16px] text-[#3c3c3c]">
            Built with Go Fiber transaction isolation and Astro SSR technology for uncompromising speed and security.
          </p>
        </div>

        <!-- 3-Column Spec Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Spec Cell 1 -->
          <div class="bg-white p-8 hairline-border">
            <div class="font-bold text-[32px] text-[#1c69d4] mb-1">0.00ms</div>
            <div class="font-bold text-[13px] tracking-[1.5px] uppercase text-[#262626] mb-4">QUOTA OVERBOOKING</div>
            <p class="font-light text-[14px] text-[#3c3c3c] leading-[1.55]">
              Atomic database row locking (`SELECT FOR UPDATE`) prevents ticket over-allocation even under high traffic concurrency.
            </p>
          </div>

          <!-- Spec Cell 2 -->
          <div class="bg-white p-8 hairline-border">
            <div class="font-bold text-[32px] text-[#262626] mb-1">MAX 4</div>
            <div class="font-bold text-[13px] tracking-[1.5px] uppercase text-[#262626] mb-4">PER TRANSACTION</div>
            <p class="font-light text-[14px] text-[#3c3c3c] leading-[1.55]">
              Strict policy enforcement guarantees equal distribution and stops commercial scalpers from hoarding seats.
            </p>
          </div>

          <!-- Spec Cell 3 -->
          <div class="bg-white p-8 hairline-border">
            <div class="font-bold text-[32px] text-[#262626] mb-1">QR-SYM</div>
            <div class="font-bold text-[13px] tracking-[1.5px] uppercase text-[#262626] mb-4">DYNAMIC VERIFICATION</div>
            <p class="font-light text-[14px] text-[#3c3c3c] leading-[1.55]">
              Instant generation of dynamic verification passes following payment clearance by system administrators.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- PRE-FOOTER CTA BAND (Dark Navy Surface)    -->
    <!-- ========================================== -->
    <section class="bg-[#1a2129] text-white py-[80px] px-6 sm:px-12 text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-bold text-[32px] md:text-[48px] leading-[1.1] mb-6">
          CONFIGURE YOUR SYMPHONIATIC ACCESS TODAY.
        </h2>
        <p class="font-light text-[18px] text-[#bbbbbb] mb-8">
          Create an account to reserve face-value tickets and receive priority notifications for new performance releases.
        </p>
        <a href="/register" class="btn-bmw-primary">
          CREATE ACCOUNT NOW
        </a>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- CLOSING FOOTER (Soft Grey #f7f7f7)        -->
    <!-- ========================================== -->
    <footer class="bg-[#f7f7f7] text-[#3c3c3c] py-[64px] px-6 sm:px-12 hairline-bottom">
      <div class="max-w-[1440px] mx-auto grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
        <div>
          <div class="font-bold text-[14px] uppercase text-[#262626] mb-4">Models</div>
          <ul class="space-y-2 font-light text-[14px]">
            <li><a href="#" class="hover:text-[#1c69d4]">Electronic Series</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">Rock Performance</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">Techno Industrial</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">Acoustic Sessions</a></li>
          </ul>
        </div>

        <div>
          <div class="font-bold text-[14px] uppercase text-[#262626] mb-4">Services</div>
          <ul class="space-y-2 font-light text-[14px]">
            <li><a href="#" class="hover:text-[#1c69d4]">Ticket Verification</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">Quota Engine</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">Admin Dashboard</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">API Specification</a></li>
          </ul>
        </div>

        <div>
          <div class="font-bold text-[14px] uppercase text-[#262626] mb-4">Dealers</div>
          <ul class="space-y-2 font-light text-[14px]">
            <li><a href="#" class="hover:text-[#1c69d4]">GBK Stadium Jakarta</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">JIExpo C1 Hall</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">Bengkel Space Bali</a></li>
          </ul>
        </div>

        <div>
          <div class="font-bold text-[14px] uppercase text-[#262626] mb-4">About SymphoniaTic</div>
          <p class="font-light text-[14px] text-[#6b6b6b] leading-[1.55] mb-4">
            Official concert ticketing architecture adhering to strict corporate design guidelines and atomic data verification standards.
          </p>
          <a href="https://github.com/Zyrexnn/SymphoniaTic" target="_blank" class="uppercase-link">
            GitHub Repository <span class="font-bold">›</span>
          </a>
        </div>
      </div>

      <div class="max-w-[1440px] mx-auto pt-8 border-t border-[#e6e6e6] flex flex-col sm:flex-row items-center justify-between text-[14px] font-light text-[#6b6b6b] gap-4">
        <div>© 2026 SymphoniaTic Corporate Inc. All rights reserved.</div>
        <div class="flex items-center gap-6">
          <a href="/PRD.md" class="hover:text-[#262626]">PRD Spec</a>
          <a href="/DESIGN.md" class="hover:text-[#262626]">Design Guidelines</a>
          <a href="#" class="hover:text-[#262626]">Legal Disclaimer</a>
        </div>
      </div>
    </footer>
  </main>
</Layout>
