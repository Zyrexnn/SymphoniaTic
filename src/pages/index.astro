---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import EventCard from '../components/EventCard.astro';

const concertLineup = [
  {
    index: "01",
    title: "ECHOES OF TOMORROW",
    artist: "KSHMR & ANYMA",
    date: "15 AUG 2026",
    venue: "GBK Stadium, Jakarta",
    price: "IDR 450.000",
    image: "/poster_1.jpg"
  },
  {
    index: "02",
    title: "MIDNIGHT RESONANCE",
    artist: "The Underground Orchestra",
    date: "28 AUG 2026",
    venue: "JIExpo Hall C1, Jakarta",
    price: "IDR 350.000",
    image: "/poster_2.jpg"
  },
  {
    index: "03",
    title: "SUB-ZERO WAREHOUSE",
    artist: "Charlotte de Witte & Amelie Lens",
    date: "12 SEP 2026",
    venue: "Bengkel Space, Bali",
    price: "IDR 600.000",
    image: "/poster_3.jpg"
  },
  {
    index: "04",
    title: "ACOUSTIC REVERIE",
    artist: "Tulus & Isyana Sarasvati",
    date: "04 OCT 2026",
    venue: "Taman Ismail Marzuki, Jakarta",
    price: "IDR 275.000",
    image: "/bmw_hero.jpg"
  }
];

const categoryTabs = ["ALL SHOWS", "ELECTRONIC", "INDIE ROCK", "TECHNO", "ACOUSTIC", "VIP ACCESS"];
---

<Layout>
  <Navbar />

  <main class="w-full max-w-full pt-[64px]">
    <!-- ========================================== -->
    <!-- HERO BAND: DARK NAVY CANVAS HERO          -->
    <!-- ========================================== -->
    <section class="bg-[#1a2129] text-white py-[96px] px-6 sm:px-12 relative overflow-hidden">
      <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Text Content -->
        <div class="lg:col-span-7 z-10">
          <div class="font-display font-bold text-[13px] tracking-[2px] uppercase text-[#1c69d4] mb-4">
            SYMPHONIATIC LIVE PERFORMANCE ARCHITECTURE
          </div>

          <!-- Wide Headline (Syne 900 Display) -->
          <h1 class="font-display font-black text-[42px] sm:text-[60px] lg:text-[72px] leading-[1.02] tracking-tight mb-6 text-white uppercase">
            LIVE SOUND. <br />
            <span class="text-[#1c69d4]">FAIR ACCESS.</span> ZERO SCALPERS.
          </h1>

          <!-- Body Text (Outfit Light 300) -->
          <p class="font-light text-[18px] text-[#bbbbbb] leading-[1.6] mb-10 max-w-2xl">
            SymphoniaTic is a high-craft concert ticketing platform. Engineered with Go Fiber database row-locking, strict 4-ticket limits, and instant QR-SYM digital verification passes.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a href="#featured" class="btn-concert-primary">
              EXPLORE LINEUP
            </a>
            <a href="/register" class="btn-concert-secondary">
              CREATE MEMBERSHIP
            </a>
          </div>
        </div>

        <!-- Visual Hero Media -->
        <div class="lg:col-span-5 z-10">
          <div class="aspect-[16/10] overflow-hidden border border-white/10 bg-[#262e38] shadow-2xl relative group">
            <img 
              src="/hero_bg_mono.jpg" 
              alt="Live Concert Stage" 
              class="w-full h-full object-cover filter contrast-125 group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute bottom-4 left-4 right-4 bg-[#1a2129]/90 backdrop-blur-md p-4 border border-white/10 flex items-center justify-between font-display text-xs">
              <span class="text-white font-bold">STAGE CAPACITY VERIFIED</span>
              <span class="text-[#1c69d4] font-mono">ONLINE</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- CATEGORY TABS BAR                         -->
    <!-- ========================================== -->
    <section class="bg-white hairline-b px-6 sm:px-12">
      <div class="max-w-[1440px] mx-auto flex items-center gap-8 overflow-x-auto py-4">
        {categoryTabs.map((tab, idx) => (
          <button class={`font-display text-[12px] font-bold tracking-[1.5px] uppercase whitespace-nowrap pb-1 border-b-2 transition-colors ${
            idx === 0 
              ? 'border-[#1c69d4] text-[#1c69d4]' 
              : 'border-transparent text-[#6b6b6b] hover:text-[#262626]'
          }`}>
            {tab}
          </button>
        ))}
      </div>
    </section>

    <!-- ========================================== -->
    <!-- FEATURED CONCERTS SECTION (80px Padding)   -->
    <!-- ========================================== -->
    <section id="featured" class="py-[80px] px-6 sm:px-12 bg-white">
      <div class="max-w-[1440px] mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 hairline-b">
          <div>
            <span class="font-display text-[12px] font-bold tracking-[1.5px] uppercase text-[#1c69d4] block mb-2">CURATED CONCERT LINEUP</span>
            <h2 class="font-display font-black text-[32px] md:text-[44px] text-[#262626] leading-[1.1] uppercase">
              UPCOMING SHOWS & PASSES.
            </h2>
          </div>
          <div class="mt-4 md:mt-0">
            <a href="#" class="link-uppercase-chevron">
              VIEW FULL SCHEDULE <span class="font-bold">›</span>
            </a>
          </div>
        </div>

        <!-- 4-Up Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {concertLineup.map((concert) => (
            <EventCard 
              index={concert.index}
              title={concert.title}
              artist={concert.artist}
              date={concert.date}
              venue={concert.venue}
              price={concert.price}
              image={concert.image}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- MANIFESTO & SYSTEM ARCHITECTURE           -->
    <!-- ========================================== -->
    <section id="manifesto" class="py-[80px] px-6 sm:px-12 bg-[#fafafa] hairline-b">
      <div class="max-w-[1440px] mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="font-display text-[12px] font-bold tracking-[1.5px] uppercase text-[#1c69d4] mb-3">
            TECHNICAL INTEGRITY
          </div>
          <h2 class="font-display font-black text-[32px] md:text-[44px] text-[#262626] leading-[1.1] uppercase mb-4">
            ATOMIC TICKETING SECURITY.
          </h2>
          <p class="font-light text-[16px] text-[#3c3c3c]">
            Designed to eliminate scalping bots and unfair markups through database-isolated transaction processing.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white p-8 border border-[#e6e6e6]">
            <div class="font-display font-extrabold text-[28px] text-[#1c69d4] mb-1">01 / ATOMIC LOCK</div>
            <div class="font-display font-bold text-[12px] tracking-[1.5px] uppercase text-[#262626] mb-3">QUOTA ISOLATION</div>
            <p class="font-light text-[14px] text-[#3c3c3c] leading-[1.6]">
              Go Fiber `db.Begin()` transaction locks remaining category quota with `SELECT FOR UPDATE` to prevent overbooking during high-demand concert releases.
            </p>
          </div>

          <div class="bg-white p-8 border border-[#e6e6e6]">
            <div class="font-display font-extrabold text-[28px] text-[#262626] mb-1">02 / FAIR LIMIT</div>
            <div class="font-display font-bold text-[12px] tracking-[1.5px] uppercase text-[#262626] mb-3">MAX 4 TICKETS</div>
            <p class="font-light text-[14px] text-[#3c3c3c] leading-[1.6]">
              Strict policy limit of 4 tickets per user transaction stops commercial scalpers from buying out entire venue sections.
            </p>
          </div>

          <div class="bg-white p-8 border border-[#e6e6e6]">
            <div class="font-display font-extrabold text-[28px] text-[#262626] mb-1">03 / QR-SYM PASS</div>
            <div class="font-display font-bold text-[12px] tracking-[1.5px] uppercase text-[#262626] mb-3">DYNAMIC PASS CODE</div>
            <p class="font-light text-[14px] text-[#3c3c3c] leading-[1.6]">
              Encrypted verification passes generated immediately upon admin payment approval, eliminating fraudulent duplicate passes.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- PRE-FOOTER CTA BAND                       -->
    <!-- ========================================== -->
    <section class="bg-[#1a2129] text-white py-[80px] px-6 sm:px-12 text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-display font-black text-[32px] md:text-[48px] leading-[1.1] uppercase mb-6">
          RESERVE YOUR CONCERT ACCESS TODAY.
        </h2>
        <p class="font-light text-[18px] text-[#bbbbbb] mb-8">
          Join SymphoniaTic for direct access to official live show drops and face-value tickets.
        </p>
        <a href="/register" class="btn-concert-primary">
          CREATE ACCOUNT NOW
        </a>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-[#f7f7f7] text-[#3c3c3c] py-[64px] px-6 sm:px-12 hairline-b">
      <div class="max-w-[1440px] mx-auto grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
        <div>
          <div class="font-display font-bold text-[13px] tracking-[1.5px] uppercase text-[#262626] mb-4">CATEGORIES</div>
          <ul class="space-y-2 font-light text-[14px]">
            <li><a href="#" class="hover:text-[#1c69d4]">Electronic Performances</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">Indie Rock Concerts</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">Techno Warehouse</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">Acoustic Sessions</a></li>
          </ul>
        </div>

        <div>
          <div class="font-display font-bold text-[13px] tracking-[1.5px] uppercase text-[#262626] mb-4">SYSTEM CORE</div>
          <ul class="space-y-2 font-light text-[14px]">
            <li><a href="#" class="hover:text-[#1c69d4]">Atomic Quota Engine</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">QR-SYM Pass Validation</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">Admin Verification API</a></li>
          </ul>
        </div>

        <div>
          <div class="font-bold text-[13px] tracking-[1.5px] uppercase text-[#262626] mb-4">PARTNER VENUES</div>
          <ul class="space-y-2 font-light text-[14px]">
            <li><a href="#" class="hover:text-[#1c69d4]">GBK Stadium Jakarta</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">JIExpo Hall C1</a></li>
            <li><a href="#" class="hover:text-[#1c69d4]">Bengkel Space Bali</a></li>
          </ul>
        </div>

        <div>
          <div class="font-display font-bold text-[13px] tracking-[1.5px] uppercase text-[#262626] mb-4">SYMPHONIATIC INC.</div>
          <p class="font-light text-[14px] text-[#6b6b6b] leading-[1.55] mb-4">
            Official concert ticketing platform adhering to strict luxury minimal design standards and atomic concurrency integrity.
          </p>
          <a href="https://github.com/Zyrexnn/SymphoniaTic" target="_blank" class="link-uppercase-chevron">
            GITHUB REPOSITORY <span class="font-bold">›</span>
          </a>
        </div>
      </div>

      <div class="max-w-[1440px] mx-auto pt-8 border-t border-[#e6e6e6] flex flex-col sm:flex-row items-center justify-between text-[13px] font-light text-[#6b6b6b] gap-4">
        <div>© 2026 SYMPHONIATIC INC. ALL RIGHTS RESERVED.</div>
        <div class="flex items-center gap-6 font-display font-bold text-[11px] tracking-wider uppercase">
          <a href="/PRD.md" class="hover:text-[#262626]">PRD SPEC</a>
          <a href="/DESIGN.md" class="hover:text-[#262626]">DESIGN SPEC</a>
          <a href="/.skills/frontend-design.md" class="hover:text-[#262626]">FRONTEND SKILL</a>
        </div>
      </div>
    </footer>
  </main>
</Layout>
