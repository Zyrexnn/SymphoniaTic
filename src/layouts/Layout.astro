---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "SymphoniaTic — Official Live Events & Concert Tickets", 
  description = "Experience world-class concerts and live events. Secured face-value ticketing, zero scalper markups, and instant digital access."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
      .font-light-body {
        font-weight: 300;
      }
      .font-heavy-title {
        font-weight: 700;
      }
    </style>
  </head>
  <body class="bg-white text-[#262626] selection:bg-[#1c69d4] selection:text-white antialiased overflow-x-hidden w-full max-w-full">
    <slot />
  </body>
</html>
