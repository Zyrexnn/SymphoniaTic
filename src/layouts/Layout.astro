---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "SymphoniaTic — Best Live Shows, Concerts & Festival Tickets", 
  description = "Discover and book tickets for the best live music events, concerts, and underground shows near you with SymphoniaTic."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      .font-display {
        font-family: 'Syne', sans-serif;
      }
    </style>
  </head>
  <body class="bg-[#0d0d0f] text-white selection:bg-[#e5fe40] selection:text-black antialiased">
    <slot />
  </body>
</html>
