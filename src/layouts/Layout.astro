---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "SYMPHONIATIC — Underground Music Manifest & Direct Tickets", 
  description = "Industrial brutalist live music ticketing platform. Direct artist connections, anti-scalper atomic quota deduction, and locked face-value passes."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;600;700&family=Syne:wght@800;900&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Space Grotesk', sans-serif;
      }
      .font-display {
        font-family: 'Syne', sans-serif;
      }
    </style>
  </head>
  <body class="bg-[#070709] text-[#f4f4f6] selection:bg-[#ff1e42] selection:text-black antialiased overflow-x-hidden w-full max-w-full">
    <slot />
  </body>
</html>
