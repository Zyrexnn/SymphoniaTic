---
// Editorial Brutalism Event Card Component
interface Props {
  title: string;
  artist: string;
  date: string;
  venue: string;
  price: string;
  image: string;
  index: string;
}

const { title, artist, date, venue, price, image, index } = Astro.props;
---

<div class="group relative bg-[#101014] border border-[#ff1e42]/20 hover:border-[#ff1e42] transition-all duration-300 flex flex-col justify-between h-full p-6">
  <!-- Top Meta Bar -->
  <div class="flex items-center justify-between font-mono text-xs text-[#ff1e42] mb-4 pb-3 border-b border-zinc-800">
    <span>// EVENT_{index}</span>
    <span class="px-2 py-0.5 bg-[#ff1e42]/10 border border-[#ff1e42]/30 text-white font-bold">{date}</span>
  </div>

  <!-- Poster Container -->
  <div class="relative aspect-[4/5] overflow-hidden bg-zinc-950 mb-6">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover filter grayscale contrast-125 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700" 
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#101014] via-transparent to-transparent opacity-80"></div>
    <div class="absolute bottom-3 left-3 text-xs font-mono text-zinc-300 bg-black/80 px-2.5 py-1">
      📍 {venue}
    </div>
  </div>

  <!-- Content -->
  <div>
    <h3 class="font-display font-black text-2xl text-white group-hover:text-[#ff1e42] transition-colors leading-none uppercase mb-2">
      {title}
    </h3>
    <p class="font-mono text-xs text-zinc-400 uppercase tracking-wide mb-6">{artist}</p>
  </div>

  <!-- Bottom Action -->
  <div class="pt-4 border-t border-zinc-800 flex items-center justify-between mt-auto">
    <div>
      <span class="text-[10px] font-mono text-zinc-500 uppercase block">PRICE</span>
      <span class="font-display font-bold text-lg text-white">{price}</span>
    </div>
    <a href="/login" class="px-4 py-2 bg-white text-black font-mono font-bold text-xs uppercase hover:bg-[#ff1e42] hover:text-white transition-colors">
      RESERVE TICKET
    </a>
  </div>
</div>
