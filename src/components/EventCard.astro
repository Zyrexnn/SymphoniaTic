---
// Event Card Component in DICE.fm bold style
interface Props {
  title: string;
  artist: string;
  venue: string;
  date: string;
  price: string;
  category: string;
  image: string;
  quotaLeft: number;
}

const { title, artist, venue, date, price, category, image, quotaLeft } = Astro.props;
---

<div class="group relative bg-[#141418] rounded-2xl overflow-hidden border border-zinc-800/80 hover:border-zinc-700 transition-all duration-300 flex flex-col h-full ticket-card-glow">
  <!-- Poster Image Container -->
  <div class="relative aspect-[4/5] overflow-hidden bg-zinc-900">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" 
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#141418] via-transparent to-black/30"></div>
    
    <!-- Top Badges -->
    <div class="absolute top-3 left-3 right-3 flex items-center justify-between">
      <span class="px-3 py-1 rounded-full text-[10px] font-extrabold tracking-wider uppercase bg-black/70 backdrop-blur-md text-white border border-white/10">
        {category}
      </span>
      {quotaLeft < 50 && (
        <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-red-500/90 text-white shadow-lg animate-pulse">
          Low Stock: {quotaLeft} left
        </span>
      )}
    </div>

    <!-- Quick Purchase Button on Hover -->
    <div class="absolute inset-x-3 bottom-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      <a href="/login" class="w-full py-3 bg-[#e5fe40] hover:bg-[#d2ec2f] text-black font-extrabold text-xs uppercase tracking-wider rounded-xl flex items-center justify-center gap-2 shadow-xl transition-transform active:scale-95">
        <span>Get Ticket</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>

  <!-- Event Info Content -->
  <div class="p-5 flex flex-col justify-between flex-1">
    <div>
      <div class="text-[#e5fe40] text-xs font-bold uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#e5fe40]"></span>
        {date}
      </div>
      <h3 class="font-display font-extrabold text-xl text-white group-hover:text-[#e5fe40] transition-colors leading-tight mb-1">
        {title}
      </h3>
      <p class="text-zinc-400 text-xs font-semibold mb-3">{artist}</p>
    </div>

    <div class="pt-4 border-t border-zinc-800/60 flex items-center justify-between mt-auto">
      <div class="flex items-center gap-1.5 text-zinc-400 text-xs truncate max-w-[60%]">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-zinc-500"><path d="M20 10c0 6-8 12-8 12s-8-6-8-10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span class="truncate">{venue}</span>
      </div>
      <div class="text-right">
        <span class="text-xs text-zinc-500 block text-[10px] uppercase font-bold">From</span>
        <span class="text-white font-extrabold text-base font-display">{price}</span>
      </div>
    </div>
  </div>
</div>
