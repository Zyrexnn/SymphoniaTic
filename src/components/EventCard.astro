---
// Event Card Component - Classical Orchestra Edition
interface Props {
  title: string;
  artist: string;
  venue: string;
  date: string;
  price: string;
  category: string;
  image: string;
  quotaLeft: number;
  time?: string;
}

const { 
  title, 
  artist, 
  venue, 
  date, 
  price, 
  category, 
  image, 
  quotaLeft, 
  time = "7:30 PM" 
} = Astro.props;
---

<div class="group relative bg-[#121824] rounded-2xl overflow-hidden border border-[#242c3d] hover:border-[#e5c158]/70 transition-all duration-300 flex flex-col h-full ticket-card-glow shadow-xl">
  <!-- Poster Image Container -->
  <div class="relative aspect-[4/3] sm:aspect-[16/11] overflow-hidden bg-[#0a0e17]">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 brightness-95" 
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#121824] via-transparent to-black/30"></div>
    
    <!-- Top Badges -->
    <div class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none">
      <span class="px-2.5 py-1 rounded-full text-[10px] font-black tracking-widest uppercase bg-[#0a0e17]/85 backdrop-blur-md text-[#e5c158] border border-[#e5c158]/40">
        {category}
      </span>
      {quotaLeft < 50 && (
        <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-[#8b152b] text-white shadow-lg animate-pulse">
          {quotaLeft} SEATS LEFT
        </span>
      )}
    </div>
  </div>

  <!-- Event Info Content -->
  <div class="p-5 flex flex-col justify-between flex-1 gap-4">
    <div>
      <!-- Date & Time (Orchestral Gold text) -->
      <div class="text-[#e5c158] text-xs font-black uppercase tracking-wider mb-1 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#e5c158]"></span>
        <span>{date}</span>
        <span class="text-zinc-500">•</span>
        <span class="text-[#b0a898] font-bold">{time}</span>
      </div>

      <!-- Category / Concert Hall line -->
      <div class="text-[#b0a898] text-[11px] font-bold uppercase tracking-widest mb-2 flex items-center gap-1">
        <span>PHILHARMONIC</span>
        <span>•</span>
        <span class="text-zinc-300 truncate">{venue}</span>
      </div>

      <!-- Title in Classical Serif / Display -->
      <h3 class="font-display font-extrabold text-lg sm:text-xl text-[#f7f4eb] group-hover:text-[#e5c158] transition-colors leading-snug mb-1 tracking-tight">
        {title}
      </h3>

      <!-- Artist / Orchestra Subhead -->
      <p class="text-[#b0a898] text-xs font-semibold">{artist}</p>
    </div>

    <!-- Bottom Section: Price & Dual Action Pill Buttons (Golden + Crimson) -->
    <div class="pt-3 border-t border-[#242c3d] flex flex-col gap-3.5 mt-auto">
      <div class="flex items-center justify-between text-xs">
        <span class="text-[#b0a898] font-bold text-[11px] uppercase tracking-wider">Tickets From</span>
        <span class="text-[#e5c158] font-black text-sm font-display tracking-tight">{price}</span>
      </div>

      <!-- Dual Action Pill Buttons (Gold BOOK + Opera Crimson MORE INFO) -->
      <div class="grid grid-cols-2 gap-2">
        <!-- Gold Button: BOOK -->
        <a 
          href="/login" 
          class="w-full py-2 px-3 bg-gradient-to-r from-[#d4af37] to-[#e5c158] hover:from-[#e5c158] hover:to-[#f3d374] text-[#0a0e17] font-black text-[11px] uppercase tracking-wider rounded-full text-center transition-transform active:scale-95 shadow-md shadow-[#e5c158]/20 flex items-center justify-center gap-1"
        >
          BOOK
        </a>

        <!-- Crimson Button: MORE INFO -->
        <a 
          href="#events" 
          class="w-full py-2 px-3 bg-[#8b152b] hover:bg-[#a61c36] text-white font-black text-[11px] uppercase tracking-wider rounded-full text-center transition-transform active:scale-95 shadow-md shadow-[#8b152b]/20 flex items-center justify-center gap-1"
        >
          MORE INFO
        </a>
      </div>
    </div>
  </div>
</div>
