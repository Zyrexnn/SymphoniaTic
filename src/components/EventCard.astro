---
// Luxury Minimal Event Card Component
interface Props {
  index: string;
  title: string;
  artist: string;
  date: string;
  venue: string;
  price: string;
  image: string;
}

const { index, title, artist, date, venue, price, image } = Astro.props;
---

<div class="bg-white flex flex-col justify-between h-full group cursor-pointer border border-[#e6e6e6] hover:border-[#1c69d4] transition-all duration-300">
  <!-- Photo Plate (#fafafa background plate, 0px radius, 16:10 ratio) -->
  <div class="bg-[#fafafa] aspect-[16/10] overflow-hidden relative border-b border-[#e6e6e6]">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 filter grayscale group-hover:grayscale-0" 
      loading="lazy"
    />
    <div class="absolute top-3 left-3 bg-[#1a2129] text-white px-3 py-1 font-display font-bold text-[10px] tracking-widest uppercase">
      {date}
    </div>
    <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm text-[#1c69d4] px-2.5 py-1 font-mono font-bold text-[10px]">
      #{index}
    </div>
  </div>

  <!-- Content (Padding 24px) -->
  <div class="p-6 flex flex-col justify-between flex-1">
    <div>
      <div class="text-[11px] font-display font-bold tracking-[1.5px] uppercase text-[#1c69d4] mb-1">
        LIVE CONCERT
      </div>
      <h3 class="font-display font-extrabold text-[20px] text-[#262626] leading-snug mb-2 group-hover:text-[#1c69d4] transition-colors">
        {title}
      </h3>
      <p class="font-light text-[14px] text-[#3c3c3c] mb-2">{artist}</p>
      <div class="text-[12px] text-[#6b6b6b] mb-4">📍 {venue}</div>
    </div>

    <div class="pt-4 border-t border-[#e6e6e6] flex items-center justify-between mt-auto">
      <div>
        <span class="text-[10px] uppercase font-display font-bold tracking-wider text-[#6b6b6b] block">STARTING FROM</span>
        <span class="font-display font-bold text-[17px] text-[#1a1a1a]">{price}</span>
      </div>
      <span class="link-uppercase-chevron">
        RESERVE <span class="font-bold">›</span>
      </span>
    </div>
  </div>
</div>
