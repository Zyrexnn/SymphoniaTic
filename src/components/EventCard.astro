---
// Bento Card Component styled with hover physics
interface Props {
  index: string;
  title: string;
  artist: string;
  date: string;
  venue: string;
  price: string;
  image: string;
  spanClass: string;
}

const { index, title, artist, date, venue, price, image, spanClass } = Astro.props;
---

<div class={`group relative bg-[#121216] rounded-3xl overflow-hidden border border-white/10 card-hover-physics flex flex-col justify-between ${spanClass}`}>
  <!-- Image Container -->
  <div class="relative w-full h-full min-h-[360px] overflow-hidden bg-zinc-950">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 filter grayscale group-hover:grayscale-0" 
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#121216] via-[#121216]/30 to-transparent"></div>

    <!-- Top Overlay Badge -->
    <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-10">
      <span class="px-3 py-1 rounded-full text-[10px] font-display font-black uppercase tracking-widest bg-black/80 backdrop-blur-md text-[#e5fe40] border border-[#e5fe40]/30">
        {date}
      </span>
      <span class="font-mono text-xs font-bold text-zinc-400">
        #{index}
      </span>
    </div>

    <!-- Bottom Content Overlay -->
    <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8 flex flex-col justify-end z-10">
      <div class="text-zinc-400 text-xs font-medium uppercase tracking-wider mb-2">
        📍 {venue}
      </div>
      <h3 class="font-display font-black text-2xl sm:text-4xl text-white group-hover:text-[#e5fe40] transition-colors leading-none uppercase mb-2">
        {title}
      </h3>
      <p class="text-zinc-400 text-sm font-light mb-6">{artist}</p>

      <div class="flex items-center justify-between pt-4 border-t border-white/10">
        <div>
          <span class="text-[10px] uppercase tracking-wider text-zinc-500 font-semibold block">Pass Tier</span>
          <span class="font-display font-extrabold text-lg text-white">{price}</span>
        </div>
        <a href="/login" class="px-6 py-2.5 bg-[#e5fe40] hover:bg-white text-black font-display font-black text-xs uppercase tracking-widest rounded-full transition-transform active:scale-95">
          Reserve Pass
        </a>
      </div>
    </div>
  </div>
</div>
