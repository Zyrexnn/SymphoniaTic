---
// BMW Corporate Style Model Card Component (4-up / 5-up Grid pattern)
interface Props {
  title: string;
  tagline: string;
  price: string;
  date: string;
  venue: string;
  image: string;
}

const { title, tagline, price, date, venue, image } = Astro.props;
---

<div class="bg-white flex flex-col justify-between h-full group cursor-pointer">
  <!-- Photo Plate (Surface Card #fafafa background, 0px radius, 16:10 aspect ratio) -->
  <div class="bg-[#fafafa] aspect-[16/10] overflow-hidden relative">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" 
      loading="lazy"
    />
    <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-3 py-1 text-[11px] font-bold tracking-wider uppercase text-[#262626]">
      {date}
    </div>
  </div>

  <!-- Model Content Area (Padding 24px) -->
  <div class="py-6 flex flex-col justify-between flex-1">
    <div>
      <!-- Model Title (18px / 700 / Weight 700) -->
      <h3 class="font-bold text-[18px] text-[#262626] leading-snug mb-1 group-hover:text-[#1c69d4] transition-colors">
        {title}
      </h3>
      <!-- One-line Tagline (14px / 300 / Light Body) -->
      <p class="font-light text-[14px] text-[#3c3c3c] mb-2">{tagline}</p>
      <div class="text-[12px] font-normal text-[#6b6b6b] mb-4">{venue}</div>
    </div>

    <div class="pt-4 border-t border-[#e6e6e6] flex items-center justify-between mt-auto">
      <div>
        <span class="text-[11px] uppercase tracking-wider text-[#6b6b6b] block">Starting From</span>
        <span class="font-bold text-[16px] text-[#1a1a1a]">{price}</span>
      </div>
      <!-- Uppercase Inline Link with Chevron -->
      <span class="uppercase-link">
        Configure <span class="text-base font-bold">›</span>
      </span>
    </div>
  </div>
</div>
