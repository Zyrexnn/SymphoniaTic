---
// Classical Orchestra Navbar Component
---
<header class="fixed top-0 left-0 right-0 z-50 glass-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logo & Brand (Golden Orchestra Emblem) -->
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-3 group">
        <!-- Orchestral Golden Clef Sunburst Logo Emblem -->
        <div class="relative w-10 h-10 rounded-full flex items-center justify-center p-0.5 overflow-hidden shadow-lg shadow-[#e5c158]/20 transform group-hover:rotate-12 transition-transform duration-500 bg-[#121824] border border-[#e5c158]/50">
          <svg viewBox="0 0 100 100" class="w-full h-full p-1.5">
            <circle cx="50" cy="50" r="46" fill="#0a0e17" stroke="#e5c158" stroke-width="2" />
            <!-- Golden Lyre / Musical Treble Clef Graphic -->
            <path d="M50 18 C50 18, 56 32, 56 42 C56 50, 48 55, 48 62 C48 68, 54 74, 60 74 C66 74, 70 68, 68 62 C66 58, 60 58, 58 62 C56 66, 62 70, 60 70 C56 70, 52 66, 52 62 C52 52, 62 48, 62 38 C62 26, 50 18, 50 18 Z" fill="#e5c158" />
            <circle cx="50" cy="80" r="4" fill="#8b152b" />
          </svg>
        </div>
        <span class="font-display font-black text-xl sm:text-2xl tracking-widest text-[#f7f4eb] flex items-center gap-1.5">
          SYMPHONIA<span class="text-[#e5c158]">TIC</span>
        </span>
      </a>

      <!-- Desktop Nav items -->
      <nav class="hidden lg:flex items-center gap-7 text-xs font-black uppercase tracking-widest">
        <a href="#events" class="text-zinc-200 hover:text-[#e5c158] transition-colors">WHAT'S ON</a>
        <a href="#orchestras" class="text-zinc-300 hover:text-[#e5c158] transition-colors">PHILHARMONICS</a>
        <a href="#halls" class="text-zinc-300 hover:text-[#e5c158] transition-colors">CONCERT HALLS</a>
        <a href="#system" class="text-zinc-300 hover:text-[#e5c158] transition-colors">FAIR ACCESS</a>
        <a href="#about" class="text-zinc-300 hover:text-[#e5c158] transition-colors">ABOUT</a>
      </nav>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-4">
      <!-- Search Button -->
      <button class="p-2.5 rounded-full bg-[#121824] border border-[#e5c158]/30 text-zinc-300 hover:text-white hover:border-[#e5c158] transition-all flex items-center gap-2 px-4 text-xs font-bold uppercase tracking-wider">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e5c158" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="hidden sm:inline">Search Symphonies...</span>
      </button>

      <!-- Golden Book Tickets Button -->
      <a href="/login" class="bg-gradient-to-r from-[#d4af37] to-[#e5c158] hover:from-[#e5c158] hover:to-[#f3d374] text-[#0a0e17] font-black text-xs uppercase tracking-wider px-5 py-2.5 rounded-full transition-all hover:scale-105 active:scale-95 shadow-md shadow-[#e5c158]/20">
        Book Tickets
      </a>

      <!-- Circular User Profile Icon -->
      <a href="/login" title="User Account" class="w-9 h-9 rounded-full bg-[#121824] border-2 border-[#e5c158]/70 hover:border-[#e5c158] flex items-center justify-center text-[#e5c158] transition-all transform hover:scale-105">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
    </div>
  </div>
</header>
