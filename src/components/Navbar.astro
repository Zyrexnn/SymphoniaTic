---
// Editorial Brutalism Navigation Bar
---
<header class="fixed top-0 inset-x-0 z-50 bg-[#070709]/90 backdrop-blur-md border-b border-[#ff1e42]/20 h-20 flex items-center">
  <div class="max-w-7xl mx-auto px-6 w-full flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 bg-[#ff1e42] text-black font-display font-black text-lg flex items-center justify-center transform -rotate-3 group-hover:rotate-0 transition-transform">
        S
      </div>
      <div class="flex flex-col">
        <span class="font-display font-black text-xl tracking-tighter text-white leading-none">
          SYMPHONIA<span class="text-[#ff1e42]">TIC</span>
        </span>
        <span class="text-[9px] font-mono tracking-widest text-[#ff1e42] uppercase">Underground Access</span>
      </div>
    </a>

    <!-- Nav Menu -->
    <nav class="hidden md:flex items-center gap-10 text-xs font-mono tracking-widest text-zinc-400 uppercase">
      <a href="#lineup" class="hover:text-[#ff1e42] transition-colors">01. LINEUP</a>
      <a href="#manifesto" class="hover:text-[#ff1e42] transition-colors">02. MANIFESTO</a>
      <a href="#system" class="hover:text-[#ff1e42] transition-colors">03. ATOMIC SYSTEM</a>
    </nav>

    <!-- CTAs -->
    <div class="flex items-center gap-4">
      <a href="/login" class="text-xs font-mono uppercase tracking-widest text-zinc-400 hover:text-white px-3 py-2 hidden sm:block">
        [ SIGN IN ]
      </a>
      <a href="/register" class="btn-raw-crimson">
        GET PASS
      </a>
    </div>
  </div>
</header>
