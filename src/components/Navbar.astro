---
// Luxury Minimal Header Navigation (64px height, hairline bottom, crisp zero-radius typography)
---
<header class="fixed top-0 inset-x-0 z-50 bg-white/90 backdrop-blur-md h-[64px] hairline-b flex items-center">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-12 w-full flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-8 h-8 rounded-none bg-[#1a2129] flex items-center justify-center text-white font-display font-black text-xs">
        ST
      </div>
      <span class="font-display font-black text-lg tracking-tight text-[#262626]">
        SYMPHONIA<span class="text-[#1c69d4]">TIC</span>
      </span>
    </a>

    <!-- Navigation Menu (Syne Bold 12px, Uppercase 1.5px tracking) -->
    <nav class="hidden md:flex items-center gap-10 font-display font-bold text-[12px] uppercase tracking-[1.5px] text-[#3c3c3c]">
      <a href="#featured" class="hover:text-[#1c69d4] transition-colors">Concerts</a>
      <a href="#manifesto" class="hover:text-[#1c69d4] transition-colors">System Core</a>
      <a href="#venues" class="hover:text-[#1c69d4] transition-colors">Venues</a>
    </nav>

    <!-- CTAs -->
    <div class="flex items-center gap-6">
      <a href="/login" class="font-display font-bold text-[12px] uppercase tracking-[1.5px] text-[#262626] hover:text-[#1c69d4] transition-colors hidden sm:block">
        Sign In
      </a>
      <a href="/register" class="btn-concert-primary">
        GET ACCESS
      </a>
    </div>
  </div>
</header>
