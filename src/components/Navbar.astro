---
// BMW Corporate Style Top Navigation Bar (64px, White Canvas, Hairline Bottom)
---
<header class="fixed top-0 inset-x-0 z-50 bg-white h-[64px] hairline-bottom flex items-center">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-12 w-full flex items-center justify-between">
    <!-- Brand Logo -->
    <div class="flex items-center gap-12">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-8 h-8 rounded-full bg-[#1a2129] flex items-center justify-center text-white font-bold text-sm tracking-tighter">
          ST
        </div>
        <span class="font-bold text-lg tracking-tight text-[#262626] uppercase">
          SYMPHONIA<span class="text-[#1c69d4]">TIC</span>
        </span>
      </a>

      <!-- Primary Horizontal Navigation (Weight 400, 14px, 0.3px tracking) -->
      <nav class="hidden md:flex items-center gap-8 text-[14px] font-normal text-[#3c3c3c] tracking-[0.3px]">
        <a href="#featured" class="hover:text-[#1c69d4] transition-colors">Featured Shows</a>
        <a href="#models" class="hover:text-[#1c69d4] transition-colors">Event Categories</a>
        <a href="#system" class="hover:text-[#1c69d4] transition-colors">Verification System</a>
        <a href="#dealers" class="hover:text-[#1c69d4] transition-colors">Official Venues</a>
      </nav>
    </div>

    <!-- Right Utility Links & Rectangular Primary Action Button -->
    <div class="flex items-center gap-6">
      <a href="/login" class="text-[14px] font-bold text-[#262626] hover:text-[#1c69d4] transition-colors hidden sm:block">
        Sign In
      </a>
      <a href="/register" class="btn-bmw-primary">
        BOOK TICKETS
      </a>
    </div>
  </div>
</header>
